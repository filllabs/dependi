{
  "name": "dependi-language-server",
  "version": "1.50.0",
  "private": true,
  "description": "Language server for the Dependi Zed extension. Reuses the VS Code parsers and registry fetchers.",
  "bin": {
    "dependi-language-server": "./dist/server.js"
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch"
  },
  "dependencies": {
    "@neuralegion/cvss": "1.3.0",
    "fast-toml": "0.5.4",
    "fast-xml-parser": "5.10.1",
    "node-cache": "5.1.2",
    "semver": "7.8.5",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/node": "22.5.0",
    "@types/semver": "7.7.1",
    "esbuild": "0.28.1",
    "typescript": "5.8.3"
  }
}
